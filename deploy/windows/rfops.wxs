<?xml version="1.0" encoding="utf-8"?>
<!-- RF Ops for Windows x64: stage station launcher (Edge kiosk) and the rfops show-file command.
     Built by .github/workflows/release.yml (WiX 3) or locally with: wixl -a x64 -D Version=0.1.0 -D Exe=… -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="RF Ops" Language="1033" Version="$(var.Version)" Manufacturer="RF Ops"
           UpgradeCode="6B7C3B7E-2F4A-4C61-9E1D-5A0F7E3C9B21">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="RF Ops stage station and show-file tool" />
    <MajorUpgrade DowngradeErrorMessage="A newer RF Ops is already installed." />
    <Media Id="1" Cabinet="rfops.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="RF Ops">
          <Component Id="Cli" Guid="0E3B6F27-6C1D-4E9A-8E54-2B7D9C1A4F10" Win64="yes">
            <File Id="RfopsExe" Name="rfops.exe" Source="$(var.Exe)" KeyPath="yes" />
            <Environment Id="PathEntry" Name="PATH" Value="[INSTALLDIR]" Permanent="no" Part="last" Action="set" System="yes" />
          </Component>
          <Component Id="Station" Guid="4C2A9E1B-7D3F-4B86-A1C5-9F0E2D6B3A47" Win64="yes">
            <File Id="StationPs1" Name="rfops-station.ps1" Source="$(var.Station)" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="MenuDir" Name="RF Ops">
          <Component Id="Shortcuts" Guid="9A1D4F6C-3B2E-4F70-8C19-6E5A2B7D1C38" Win64="yes">
            <Shortcut Id="StationShortcut" Name="RF Ops Station" Description="Full-screen RF Ops board"
                      Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                      Arguments="-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLDIR]rfops-station.ps1&quot;"
                      WorkingDirectory="INSTALLDIR" />
            <Shortcut Id="StationSetupShortcut" Name="RF Ops Station settings" Description="Change the address and start-at-login"
                      Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                      Arguments="-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLDIR]rfops-station.ps1&quot; -Setup"
                      WorkingDirectory="INSTALLDIR" />
            <RemoveFolder Id="RemoveMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\RF Ops" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="RF Ops" Level="1">
      <ComponentRef Id="Cli" />
      <ComponentRef Id="Station" />
      <ComponentRef Id="Shortcuts" />
    </Feature>
  </Product>
</Wix>
